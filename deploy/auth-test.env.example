# Скопируйте этот шаблон в отдельный приватный auth-test.env на сервере.
# Реальные значения в Git и в чат не передаются.
MAX_PHONE=

# Впишите тот же сетевой режим, который использовался в предыдущем тесте:
# direct или http_connect. Пустое значение намеренно не запускается.
AUTH_TEST_EGRESS_TYPE=

# Заполняйте только для AUTH_TEST_EGRESS_TYPE=http_connect.
# MAX_EGRESS_PROXY_URL=
