# Скопировать на сервере в .env.staging. Не добавлять реальные значения в Git.
TG_OWNER_ID=<TELEGRAM_OWNER_ID>
TG_FORUM_GROUP_ID=<TELEGRAM_FORUM_GROUP_ID>
TG_ALLOWED_USER_IDS=<TELEGRAM_USER_ID_1>,<TELEGRAM_USER_ID_2>
TG_BOT_USERNAME=<BRIDGE_BOT_USERNAME>
OUTBOUND_ENABLED=false

# Скопировать на сервере в .env.staging.secrets и заполнить только там.
TG_BOT_TOKEN=
MAX_PHONE=
